{
  "name": "awesome-lyrla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsup src/server/index.ts src/server/apple-lyrics-worker.ts --format esm --platform node --target node22 --out-dir dist-server --sourcemap --clean",
    "start": "node dist-server/index.js",
    "lint": "eslint . --max-warnings=0",
    "format:check": "node scripts/check-format.mjs",
    "format:changed": "node scripts/check-format.mjs --write",
    "architecture:check": "depcruise --config dependency-cruiser.config.cjs src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run src/shared/quality-properties.test.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:mutation": "stryker run",
    "test:mutation:critical": "node scripts/run-critical-mutation.mjs",
    "test:e2e": "playwright test",
    "coverage:diff": "node scripts/check-diff-coverage.mjs",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "static:check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run static:check && npm run architecture:check && npm test && npm run build",
    "release:check": "node scripts/deploy-production.mjs --check-only",
    "deploy:production": "node scripts/deploy-production.mjs",
    "tesla:keygen": "tsx scripts/generate-tesla-keys.ts",
    "tesla:certgen": "tsx scripts/generate-telemetry-certs.ts",
    "lyrics:preload-playlist": "tsx scripts/preload-apple-playlist.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.0",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/urbanist": "^5.2.7",
    "aedes": "^1.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "saxes": "^6.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.6",
    "supabase": "2.115.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
