NODE_ENV=development
PORT=8791
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PIN=change-to-6-plus-digits
DEMO_MODE=true

# Bounded hot lyrics cache. Supabase is optional.
LRCLIB_REQUEST_TIMEOUT_MS=12000
LRCLIB_LOOKUP_BUDGET_MS=18000
LYRICS_MEMORY_CACHE_MAX_ENTRIES=300
LYRICS_MEMORY_CACHE_MAX_BYTES=4194304
LYRICS_LEGACY_CACHE_MAX_ENTRIES=300
LYRICS_LEGACY_CACHE_MAX_BYTES=8388608
SUPABASE_LYRICS_MODE=off
SUPABASE_PALETTE_MODE=off
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_LIBRARY_ID=00000000-0000-4000-8000-000000000001
SUPABASE_REQUEST_TIMEOUT_MS=400
SUPABASE_SHADOW_REQUEST_TIMEOUT_MS=800
SUPABASE_PALETTE_READ_TIMEOUT_MS=500
SUPABASE_WRITE_TIMEOUT_MS=3000

# Apple Music Catalog metadata enrichment (optional but recommended)
# Use either a pre-generated developer token or all three signing-key values.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=./secrets/apple-music-private-key.p8
APPLE_MUSIC_STOREFRONT=us
# Comma-separated, at most the first two unique fallback storefronts are queried per lookup.
APPLE_MUSIC_FALLBACK_STOREFRONTS=cn,tw,hk

# Experimental asynchronous Apple TTML supplementation. Disabled by default.
# Keep media-user-token and any explicit web bearer token in a secret store.
APPLE_LYRICS_BACKFILL_ENABLED=false
APPLE_LYRICS_RUNNER_MODE=embedded
APPLE_LYRICS_EMBEDDED_COMPATIBILITY=false
APPLE_MUSIC_MEDIA_USER_TOKEN=
APPLE_MUSIC_WEB_BEARER_TOKEN=
APPLE_LYRICS_LOCALE=und
APPLE_LYRICS_REQUEST_TIMEOUT_MS=10000
APPLE_LYRICS_POLL_INTERVAL_MS=15000
APPLE_LYRICS_LEASE_SECONDS=300
APPLE_LYRICS_JOB_DEADLINE_MS=210000
APPLE_LYRICS_CLEANUP_GRACE_MS=35000
APPLE_LYRICS_WORKER_HEALTH_PORT=8792
APPLE_LYRICS_MAX_ATTEMPTS=5
APPLE_LYRICS_CONCURRENCY=1

# Tesla Developer application
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_AUTH_BASE=https://auth.tesla.com/oauth2/v3
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_PUBLIC_KEY_PATH=./secrets/tesla-public-key.pem
TESLA_PRIVATE_KEY_PATH=./secrets/tesla-private-key.pem
TESLA_ALLOWED_VIN=
TESLA_COMMAND_PROXY_URL=

# Fleet Telemetry
TELEMETRY_HOST=
TELEMETRY_PORT=443
TELEMETRY_CA_PATH=./secrets/telemetry-ca.pem
MQTT_PORT=1883
MQTT_USERNAME=awesome-lyrla
MQTT_PASSWORD=replace-with-a-random-password
MQTT_TOPIC_BASE=awesome-lyrla
