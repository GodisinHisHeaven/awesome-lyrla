app = "awesome-lyrla-yourname"
primary_region = "ord"
kill_signal = "SIGTERM"
kill_timeout = "50s"

[build]
  dockerfile = "Dockerfile"

[processes]
  app = "/usr/local/bin/awesome-lyrla-entrypoint"

[env]
  PORT = "8791"
  DATA_DIR = "/data"
  DEMO_MODE = "false"
  APP_ORIGIN = "https://awesome-lyrla-yourname.fly.dev"
  LRCLIB_REQUEST_TIMEOUT_MS = "12000"
  LRCLIB_LOOKUP_BUDGET_MS = "18000"
  SUPABASE_LYRICS_MODE = "off"
  SUPABASE_PALETTE_MODE = "off"
  APPLE_MUSIC_STOREFRONT = "us"
  APPLE_MUSIC_FALLBACK_STOREFRONTS = "cn,tw,hk"
  APPLE_LYRICS_BACKFILL_ENABLED = "false"
  APPLE_LYRICS_RUNNER_MODE = "embedded"
  APPLE_LYRICS_EMBEDDED_COMPATIBILITY = "true"
  TESLA_AUDIENCE = "https://fleet-api.prd.na.vn.cloud.tesla.com"
  TESLA_AUTH_BASE = "https://auth.tesla.com/oauth2/v3"
  TESLA_TOKEN_URL = "https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token"
  TESLA_PUBLIC_KEY_PATH = "/secrets/tesla-public-key.pem"
  TESLA_PRIVATE_KEY_PATH = "/secrets/tesla-private-key.pem"
  TESLA_COMMAND_PROXY_URL = "https://localhost:4443"
  TELEMETRY_HOST = "awesome-lyrla-yourname.fly.dev"
  TELEMETRY_PORT = "4443"
  TELEMETRY_CA_PATH = "/secrets/telemetry-ca.pem"
  MQTT_PORT = "1883"
  MQTT_USERNAME = "awesome-lyrla"
  MQTT_TOPIC_BASE = "awesome-lyrla"
  NODE_EXTRA_CA_CERTS = "/secrets/telemetry-ca.pem"

[http_service]
  processes = ["app"]
  internal_port = 8791
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [http_service.concurrency]
    type = "connections"
    soft_limit = 100
    hard_limit = 150

  [[http_service.checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "15s"
    method = "GET"
    path = "/healthz"

[[services]]
  processes = ["app"]
  protocol = "tcp"
  internal_port = 8443
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[services.ports]]
    port = 4443
    handlers = []

  [[services.tcp_checks]]
    interval = "15s"
    timeout = "2s"
    grace_period = "45s"

[[mounts]]
  source = "awesome_lyrla_data"
  destination = "/data"
  processes = ["app"]

[[files]]
  guest_path = "/secrets/tesla-public-key.pem"
  secret_name = "TESLA_PUBLIC_KEY_PEM"

[[files]]
  guest_path = "/secrets/tesla-private-key.pem"
  secret_name = "TESLA_PRIVATE_KEY_PEM"

[[files]]
  guest_path = "/secrets/telemetry-ca.pem"
  secret_name = "TELEMETRY_CA_PEM"

[[files]]
  guest_path = "/secrets/proxy-server-cert.pem"
  secret_name = "PROXY_SERVER_CERT_PEM"

[[files]]
  guest_path = "/secrets/proxy-server-key.pem"
  secret_name = "PROXY_SERVER_KEY_PEM"

[[files]]
  guest_path = "/secrets/telemetry-server.json"
  secret_name = "TELEMETRY_CONFIG_JSON"

[[files]]
  guest_path = "/secrets/telemetry-server-cert.pem"
  secret_name = "TELEMETRY_SERVER_CERT_PEM"

[[files]]
  guest_path = "/secrets/telemetry-server-key.pem"
  secret_name = "TELEMETRY_SERVER_KEY_PEM"

[[vm]]
  processes = ["app"]
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1
